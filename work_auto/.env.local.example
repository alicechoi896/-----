# 콘텐츠 자동화 센터 환경변수 예시
# 이 파일을 .env.local 로 복사해서 사용합니다. (.env.local 은 git 에 올리지 않습니다)

# ── Supabase (설정하면 로그인 + DB 모드, 비워두면 데모 모드) ──
# Supabase 대시보드 → Project Settings → API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# mock: 모든 외부 API 를 Mock 으로 사용 (기본값)
# live: API 연결 센터에서 연결한 Provider 는 실제 API 를 호출
PROVIDER_MODE=mock

# API Key 암호화 키 (32바이트 base64). 운영 환경에서는 필수입니다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# OpenAI 모델 (PROVIDER_MODE=live 일 때 사용)
OPENAI_MODEL=gpt-4o-mini

# Mock 응답 지연(ms). 로딩 화면을 확인할 때 사용합니다. 0 이면 지연 없음
MOCK_LATENCY_MS=0

# 데모 모드에서 데모 사용자의 역할 (admin / silver / gold / vip). 등급별 화면 확인용
# DEMO_ROLE=silver
